# =============================================================
# LLM Provider Configuration
# Uncomment ONE block below and comment out the others.
# =============================================================

# --- Option 1: Ollama (local, free, no internet required) ---
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:7b
# Setup: https://ollama.com/download  →  ollama pull qwen2.5:7b
# LLM_SLEEP=1

# --- Option 2: Groq Cloud (free tier, fast, cloud) ----------
# Get API key: https://console.groq.com/keys
# OPENAI_API_KEY=gsk_your_groq_api_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b
# Recommended model alternatives: openai/gpt-oss-20b (faster), qwen/qwen3.6-27b (preview)
# NOTE: qwen-qwq-32b and qwen/qwen3-32b are both decommissioned as of July 2026
# Free tier rate limit: ~1K RPM depending on model — set LLM_SLEEP=2
# LLM_SLEEP=2

# --- Option 3: Google Gemini Flash (free tier, OpenAI-compatible) ---
# Get API key: https://aistudio.google.com/apikey
# OPENAI_API_KEY=your_gemini_api_key_here
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.0-flash
# Recommended model alternatives: gemini-1.5-flash, gemini-2.5-flash-preview-05-20
# Free tier rate limit: 15 RPM — set LLM_SLEEP=5
# LLM_SLEEP=5